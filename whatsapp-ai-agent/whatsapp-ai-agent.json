      ],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "jsCode": "const triggerData = $('WhatsApp Trigger').first().json;\nconst phone = triggerData.messages[0].from;\nconst msg = triggerData.messages[0];\n\nlet userMessage = '[unknown]';\nif (msg.text) userMessage = msg.text.body;\nelse if (msg.image) userMessage = '[image] ' + (msg.image.caption || '');\nelse if (msg.audio) userMessage = '[voice note]';\nelse if (msg.document) userMessage = '[file] ' + (msg.document.filename || '');\n\nconst aiResponse = $('AI Agent1').first().json.output;\n\nlet contactId;\nconst existingContactNode = $('Chatwoot: Contact Exists?').first().json;\n\nif (existingContactNode && existingContactNode.contact_exists) {\n    contactId = existingContactNode.contact_id;\n} else {\n    const newNode = $('Chatwoot: Create Contact').first().json;\n    contactId = newNode.id;\n}\n\nreturn [{\n  json: {\n    contact_id: contactId,\n    user_message: userMessage,\n    ai_response: aiResponse,\n    phone: phone\n  }\n}];"
      },
