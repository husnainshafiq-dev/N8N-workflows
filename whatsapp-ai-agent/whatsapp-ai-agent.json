    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst phone = $('WhatsApp Trigger').first().json.messages[0].from;\nconst name = $('WhatsApp Trigger').first().json.contacts[0].profile.name || phone;\n\nconst contacts = data.payload || [];\nconst existing = contacts.find(c => c.phone_number === ('+' + phone));\n\nreturn [{\n  json: {\n    contact_id: existing ? existing.id : null,\n    phone: phone,\n    name: name,\n    contact_exists: existing ? true : false\n  }\n}];"
      },
